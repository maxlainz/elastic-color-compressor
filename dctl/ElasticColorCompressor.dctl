__DEVICE__ float3 a2_mul(__CONSTANTREF__ float* m, float3 v) {
    return make_float3(v.x * m[0] + v.y * m[3] + v.z * m[6],
                       v.x * m[1] + v.y * m[4] + v.z * m[7],
                       v.x * m[2] + v.y * m[5] + v.z * m[8]);
}
__DEVICE__ float a2_lerp(float a, float b, float t) { return a + t * (b - a); }
__DEVICE__ float3 a2_clamp3(float3 v, float lo, float hi) {
    return make_float3(_clampf(v.x, lo, hi), _clampf(v.y, lo, hi), _clampf(v.z, lo, hi));
}

// post_adaptation_cone_response_compression_fwd / _inv
__DEVICE__ float a2_cone_fwd(float v) {
    float f = _powf(_fabs(v), 0.42f);
    return _copysignf(f / (A2_NL_OFFSET + f), v);
}
__DEVICE__ float a2_cone_inv(float v) {
    float ra = _fminf(_fabs(v), 0.99f);
    return _copysignf(_powf(A2_NL_OFFSET * ra / (1.0f - ra), 1.0f / 0.42f), v);
}
__DEVICE__ float a2_Y_to_J(float Y) {
    float ra = a2_cone_fwd(_fabs(Y) * A2_F_L_N);
    return _copysignf(100.0f * _powf(ra / A2_A_W_J, A2_CZ), Y);
}
__DEVICE__ float a2_J_to_Y(float J) {
    return a2_cone_inv(A2_A_W_J * _powf(_fabs(J) * 0.01f, 1.0f / A2_CZ)) / A2_F_L_N;
}
// RGB_to_JMh / JMh_to_RGB (hue in degrees, [0, 360)) with the matrices of one JMhParams
__DEVICE__ float3 a2_rgb_to_JMh(float3 rgb, __CONSTANTREF__ float* to_cam, __CONSTANTREF__ float* to_aab) {
    float3 c = a2_mul(to_cam, rgb);
    float3 Aab = a2_mul(to_aab, make_float3(a2_cone_fwd(c.x), a2_cone_fwd(c.y), a2_cone_fwd(c.z)));
    if (Aab.x <= 0.0f) return make_float3(0.0f, 0.0f, 0.0f);
    float h = _atan2f(Aab.z, Aab.y) * 57.29577951f;
    if (h < 0.0f) h += 360.0f;
    return make_float3(100.0f * _powf(Aab.x, A2_CZ), _sqrtf(Aab.y * Aab.y + Aab.z * Aab.z), h);
}
__DEVICE__ float3 a2_JMh_to_rgb(float3 jmh, __CONSTANTREF__ float* from_aab, __CONSTANTREF__ float* from_cam) {
    float hr = jmh.z * 0.01745329252f;
    float3 Aab = make_float3(_powf(jmh.x * 0.01f, 1.0f / A2_CZ), jmh.y * _cosf(hr), jmh.y * _sinf(hr));
    float3 c = a2_mul(from_aab, Aab);
    return a2_mul(from_cam, make_float3(a2_cone_inv(c.x), a2_cone_inv(c.y), a2_cone_inv(c.z)));
}
// reach_M_from_table (one entry per degree of hue)
__DEVICE__ float a2_reach_M(float h) {
    int base = (int)_fminf(h, 359.0f);
    return a2_lerp(A2_REACH_M[base + 1], A2_REACH_M[base + 2], h - (float)base);
}
// upper index i of the interval hue[i - 1] < h <= hue[i] of A2_CUSPS, bisecting from index lo up
// (cusp_from_table: lo = 0; lookup_hue_interval: lo = 1; same result as the CTL's narrowed start)
__DEVICE__ int a2_hue_interval(float h, int lo) {
    int hi = 361;
    while (lo + 1 < hi) {
        int i = (lo + hi) / 2;
        if (h > A2_CUSPS[3 * i + 2]) lo = i; else hi = i;
    }
    return hi;
}
__DEVICE__ float a2_toe(float x, float limit, float k1_in, float k2_in, int invert) {
    if (x > limit) return x;
    float k2 = _fmaxf(k2_in, 0.001f);
    float k1 = _sqrtf(k1_in * k1_in + k2 * k2);
    float k3 = (limit + k1) / (limit + k2);
    if (invert) return (x * x + k1 * x) / (k3 * (x + k2));
    float mb = k3 * x - k1, mc = k2 * k3 * x;
    return 0.5f * (mb + _sqrtf(mb * mb + 4.0f * mc));
}
__DEVICE__ float a2_chroma_compress_norm(float h) {
    float hr = h * 0.01745329252f;
    float a = _cosf(hr), b = _sinf(hr);
    float M = 11.34072f * a + 16.46899f * (a * a - b * b) + 7.88380f * (4.0f * a * a * a - 3.0f * a)
            + 14.66441f * b - 6.37224f * (2.0f * a * b) + 9.19364f * (3.0f * b - 4.0f * b * b * b) + 77.12896f;
    return M * A2_CC_SCALE;
}
// chroma_compress_fwd / _inv: M (scene, at J) <-> M (display, at tonemapped Jt)
__DEVICE__ float a2_chroma_compress(float M, float J, float Jt, float h, int invert) {
    if (M == 0.0f) return M;
    float nJ = Jt / A2_J_MAX;
    float snJ = _fmaxf(0.0f, 1.0f - nJ);
    float Mnorm = a2_chroma_compress_norm(h);
    float limit = _powf(nJ, 1.0f / A2_CZ) * a2_reach_M(h) / Mnorm;
    float k2s = _sqrtf(nJ * nJ + A2_SAT_THR);
    if (invert) {
        M = a2_toe(M / Mnorm, limit, nJ * A2_COMPR, snJ, 1);
        M = limit - a2_toe(limit - M, limit - 0.001f, snJ * A2_SAT, k2s, 1);
        return M * Mnorm * _powf(Jt / J, -1.0f / A2_CZ);
    }
    M = M * _powf(Jt / J, 1.0f / A2_CZ) / Mnorm;
    M = limit - a2_toe(limit - M, limit - 0.001f, snJ * A2_SAT, k2s, 0);
    return a2_toe(M, limit, nJ * A2_COMPR, snJ, 0) * Mnorm;
}
// tonescale_fwd / tonescale_inv (luminance / 100 <-> scene linear)
__DEVICE__ float a2_tonescale(float x, int invert) {
    if (invert) {
        float Z = _fmaxf(0.0f, _fminf(A2_TS_N / (A2_TS_U2 * A2_TS_NR), x));
        float th = (Z + _sqrtf(Z * (4.0f * A2_TS_T1 + Z))) * 0.5f;
        return (th > 0.0f) ? A2_TS_S2 / (_powf(A2_TS_M2 / th, 1.0f / A2_TS_G) - 1.0f) : 0.0f;  // CTL: s2 / inf = 0
    }
    float f = A2_TS_M2 * _powf(_fmaxf(0.0f, x) / (x + A2_TS_S2), A2_TS_G);
    return _fmaxf(0.0f, f * f / (f + A2_TS_T1)) * A2_TS_NR * 0.01f;
}
// tonemap_and_compress_fwd / _inv
__DEVICE__ float3 a2_tonemap_and_compress(float3 jmh, int invert) {
    float J = a2_Y_to_J(a2_tonescale(a2_J_to_Y(jmh.x) * 0.01f, invert) * 100.0f);
    float M = invert ? a2_chroma_compress(jmh.y, J, jmh.x, jmh.z, 1) : a2_chroma_compress(jmh.y, jmh.x, J, jmh.z, 0);
    return make_float3(J, M, jmh.z);
}

// gamut compression, init_HueDependentGamutParams (one hue interval for cusp and gamma, as in OpenColorIO)
typedef struct { float cJ, cM, focusJ, thr, gTopInv; } A2Hue;
__DEVICE__ A2Hue a2_hue_params(float h) {
    A2Hue p;
    int ic = a2_hue_interval(h, 1);
    float tc = (h - A2_CUSPS[3 * ic - 1]) / (A2_CUSPS[3 * ic + 2] - A2_CUSPS[3 * ic - 1]);
    p.gTopInv = a2_lerp(A2_UPPER_GAMMA_INV[ic - 1], A2_UPPER_GAMMA_INV[ic], tc);
    p.cJ = a2_lerp(A2_CUSPS[3 * ic - 3], A2_CUSPS[3 * ic], tc);
    p.cM = a2_lerp(A2_CUSPS[3 * ic - 2], A2_CUSPS[3 * ic + 1], tc);
    p.focusJ = a2_lerp(p.cJ, A2_MID_J, _fminf(1.0f, 1.3f - p.cJ / A2_J_MAX));
    p.thr = a2_lerp(p.cJ, A2_J_MAX, 0.3f);
    return p;
}
__DEVICE__ float a2_solve_J_intersect(float J, float M, float focusJ, float gain) {
    float Ms = M / gain;
    float a = Ms / focusJ;
    if (J < focusJ) {
        float b = 1.0f - Ms, c = -J;
        return -2.0f * c / (b + _sqrtf(b * b - 4.0f * a * c));
    }
    float b = -(1.0f + Ms + A2_J_MAX * a), c = A2_J_MAX * Ms + J;
    return -2.0f * c / (b - _sqrtf(b * b - 4.0f * a * c));
}
// estimate_line_and_boundary_intersection_M
__DEVICE__ float a2_line_boundary_M(float J_axis, float slope, float inv_gamma, float J_max, float M_max, float J_ref) {
    return J_ref * _powf(J_axis / J_ref, inv_gamma) * M_max / (J_max - slope * M_max);
}
// compress_gamut
__DEVICE__ float3 a2_compress_gamut(float3 jmh, float Jx, A2Hue p, int invert) {
    float J = jmh.x, M = jmh.y, h = jmh.z;
    float gain = A2_J_MAX * A2_FOCUS_DIST;                                   // get_focus_gain
    if (Jx > p.thr) {
        float adj = _log10f((A2_J_MAX - p.thr) / _fmaxf(0.0001f, A2_J_MAX - Jx));
        gain *= adj * adj + 1.0f;
    }
    float Jis = a2_solve_J_intersect(J, M, p.focusJ, gain);
    float slope = ((Jis < p.focusJ) ? Jis : A2_J_MAX - Jis) * (Jis - p.focusJ) / (p.focusJ * gain);
    float Jic = a2_solve_J_intersect(p.cJ, p.cM, p.focusJ, gain);
    float lo = a2_line_boundary_M(Jis, slope, A2_LOWER_GAMMA_INV, p.cJ, p.cM, Jic);  // find_gamut_boundary_intersection
    float up = a2_line_boundary_M(A2_J_MAX - Jis, -slope, p.gTopInv, A2_J_MAX - p.cJ, p.cM, A2_J_MAX - Jic);
    float s = 0.12f * p.cM;                                                  // smin_scaled
    float sh = _fmaxf(s - _fabs(lo - up), 0.0f) / s;
    float gM = _fminf(lo, up) - sh * sh * sh * s * (1.0f / 6.0f);
    if (gM <= 0.0f) return make_float3(J, 0.0f, h);
    float rM = a2_line_boundary_M(Jis, slope, 1.0f / A2_CZ, A2_J_MAX, a2_reach_M(h), A2_J_MAX);
    float prop = _fmaxf(gM / rM, 0.75f);                                     // remap_M
    float t0 = prop * gM;
    float Mr = M;
    if (M > t0 && prop < 1.0f) {
        float ro = rM - t0;
        float scale = ro / (ro / (gM - t0) - 1.0f);
        float nd = (M - t0) / scale;                                         // reinhard_remap
        if (invert) Mr = t0 + ((nd >= 1.0f) ? scale : scale * -(nd / (nd - 1.0f)));
        else        Mr = t0 + scale * nd / (1.0f + nd);
    }
    return make_float3(Jis + Mr * slope, Mr, h);
}
// gamut_compress_fwd / gamut_compress_inv
__DEVICE__ float3 a2_gamut_compress(float3 jmh, int invert) {
    if (jmh.x <= 0.0f) return make_float3(0.0f, 0.0f, jmh.z);
    if (jmh.y < 0.0f || jmh.x > A2_J_MAX) return make_float3(jmh.x, 0.0f, jmh.z);
    A2Hue p = a2_hue_params(jmh.z);
    float Jx = jmh.x;
    if (invert && Jx > p.thr) Jx = a2_compress_gamut(jmh, Jx, p, 1).x;     // approximate inverse above threshold
    return a2_compress_gamut(jmh, Jx, p, invert);
}

// outputTransform_fwd + peak clamp: ACES2065-1 -> limiting (= display) linear Rec.709 RGB, [0, 1]
__DEVICE__ float3 aces2_fwd(float3 aces) {
    float3 ap0 = a2_mul(A2_AP1_TO_AP0, a2_clamp3(a2_mul(A2_AP0_TO_AP1, aces), 0.0f, A2_TS_FWD_LIMIT));  // clamp_AP0_to_AP1
    float3 jmh = a2_rgb_to_JMh(ap0, A2_INPUT_RGB_TO_CAM, A2_INPUT_CONE_TO_AAB);
    jmh = a2_gamut_compress(a2_tonemap_and_compress(jmh, 0), 0);
    return a2_clamp3(a2_JMh_to_rgb(jmh, A2_LIMIT_AAB_TO_CONE, A2_LIMIT_CAM_TO_RGB), 0.0f, 1.0f);
}
// outputTransform_inv: limiting linear Rec.709 RGB -> ACES2065-1
__DEVICE__ float3 aces2_inv(float3 rgb) {
    float3 jmh = a2_rgb_to_JMh(rgb, A2_LIMIT_RGB_TO_CAM, A2_LIMIT_CONE_TO_AAB);
    jmh = a2_tonemap_and_compress(a2_gamut_compress(jmh, 1), 1);
    return a2_JMh_to_rgb(jmh, A2_INPUT_AAB_TO_CONE, A2_INPUT_CAM_TO_RGB);
}
// Display EOTF, Lib.Academy.DisplayEncoding.ctl: srgb = 0 BT.1886 (gamma 2.4, Lb = 0), 1 sRGB
// (moncurve, gamma 2.4, offset 0.055: break 0.055 / 1.4, linear slope 12.9232102)
__DEVICE__ float a2_eotf(float v, int srgb) {
    if (!srgb) return _powf(v, 2.4f);
    return (v >= 0.0392857143f) ? _powf((v + 0.055f) / 1.055f, 2.4f) : v / 12.9232102f;
}
// Display code values (0-1) -> ACES2065-1 that the forward transform renders to them. Display and
// limiting primaries are both Rec.709 D65: no matrix and no white scaling around the transform.
// The CTL inverse is approximate where the focus gain depends on J (above the analytical threshold,
// near the top of the gamut): one fixed-point step against the forward transform removes that error,
// x1 = x0 + (inv(rgb) - inv(fwd(x0))).
__DEVICE__ float3 aces2_target(float3 cv, int srgb) {
    float3 rgb = make_float3(a2_eotf(cv.x, srgb), a2_eotf(cv.y, srgb), a2_eotf(cv.z, srgb));
    float3 x0 = aces2_inv(rgb);
    return x0 + (x0 - aces2_inv(aces2_fwd(x0)));
}

// Target Color (picker code values) -> XYZ (D65), per Target Output
__DEVICE__ float3 target_xyz(float3 t, int to, int ws) {
    t = a2_clamp3(t, 0.0f, 1.0f);
    if (to == TO_NONE) return rgb_to_xyz(decode_log(t, ws), ws);
    return mat_ap1_to_xyz(a2_mul(A2_AP0_TO_AP1, aces2_target(t, to == TO_ACES2_SRGB)));
}

// kernels in [0, 1], 1 at the target, smooth (C-infinity)
__DEVICE__ float wrap_pi(float d) { return d - 6.283185307f * _round(d / 6.283185307f); }
__DEVICE__ float k_hue(float d, float w)  { return _expf((_cosf(d) - 1.0f) / (w * w)); }   // periodic von Mises
__DEVICE__ float k_gauss(float x)         { return _expf(-0.5f * x * x); }

__DEVICE__ float4 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B, float p_A)
{
    int ws = workingSpace;
    // --- target: picker code values (uniform), to scene XYZ per Target Output ---
    // Oklab a, b are measured from the grey axis: with these matrices a grey has (a, b) = L * (NA, NB),
    // not (0, 0) (Oklab M1 vs D65 rounding). Shearing it out makes C = 0 exactly on greys, so greys never move.
    float3 txyz = target_xyz(make_float3(target.r, target.g, target.b), targetOutput, ws);   // the picker is not a float3
    float3 tl = xyz_to_oklab(txyz);
    float tL = tl.x;
    float ta = tl.y - tL * NEUTRAL_A, tb = tl.z - tL * NEUTRAL_B;
    float tCr = _sqrtf(ta * ta + tb * tb);
    float tH = (tCr > 0.0f) ? _atan2f(tb, ta) : 0.0f;               // black target: atan2(0, 0) is not portable
    float tC = _fmaxf(tCr, 0.005f);                                  // grey target: floor keeps ln finite

    // grey target has no hue: fade the hue selectivity out smoothly (uniform, ~1 for any real colour)
    float fH = tCr * tCr / (tCr * tCr + 0.000004f);
    // Mix scales the strengths (not the result): every slope stays >= 1 - strength * mix > 0, so no fold at any Mix
    float sH = _fminf(hueCompress, 0.99f) * fH * mix;
    float sC = _fminf(satCompress, 0.99f) * mix;
    float sL = _fminf(lumaCompress, 0.99f) * mix;
    float wH = hueRange * 0.01745329252f;
    float wC = _fmaxf(satRange, 0.01f);
    float wL = _fmaxf(lumaRange, 0.001f);
    float tRel = tC / _fmaxf(tL, 0.01f);                        // target chroma relative to its luma

    float3 lin = decode_log(make_float3(p_R, p_G, p_B), ws);
    float3 lab = rgb_to_oklab(lin, ws);
    float L = lab.x;
    float a = lab.y - L * NEUTRAL_A, b = lab.z - L * NEUTRAL_B;
    float C = _sqrtf(a * a + b * b);
    float h = (C > 0.0f) ? _atan2f(b, a) : 0.0f;                    // numerical guard: at C = 0 output ignores h

    // Coordinates (L, h, s) with s = ln(C / L): hue and s do not change with exposure, so an exposure ramp
    // only moves L. Steps 2 and 3 read only (h, s), so the colour change is the same at every exposure and
    // an exposure ramp comes out as an exposure ramp (no luminance reversal). L floor 0.01 (deep below black).
    float Lr = _fmaxf(L, 0.01f);
    float r  = C / Lr;
    float u  = _logf(_fmaxf(r, 1e-12f) / tRel) / wC;                // saturation distance, in Zone Sat Range units
    float q  = r * r / (r * r + 1e-6f);                              // float32 grey noise (C / L ~ 1e-6) never moves

    float d0  = wrap_pi(h - tH);
    float kh0 = 1.0f - fH * (1.0f - k_hue(d0, wH));                  // hue kernel; all hues for a grey target
    float zone = kh0 * k_gauss(u) * k_gauss((L - tL) / wL);          // alpha: zone weight on the ORIGINAL colour

    // 1. luma: L moves, weight from (h, s) only. slope >= 1 - sL
    float xL = (L - tL) / wL;
    float Ln = L - sL * q * kh0 * k_gauss(u) * (xL * k_gauss(xL)) * wL;

    // 2. hue: h moves, weight from s only. slope >= 1 - sH
    float dn = d0 - sH * q * k_gauss(u) * _sinf(d0) * k_hue(d0, wH);

    // 3. saturation: s moves, weight from h' only. slope >= 1 - sC
    float khn = 1.0f - fH * (1.0f - k_hue(dn, wH));
    float un  = u - sC * khn * u * k_gauss(u);

    // apply as a DELTA (rotate + scale the original a, b; no rebuild from cos/sin): exactly 0 where nothing
    // moves, so far-away colours come back bit-exact. C' / C = (L' / L) * exp(s' - s).
    float sc = (_fmaxf(Ln, 0.01f) / Lr) * _expf((un - u) * wC);
    float rc = _cosf(dn - d0), rs = _sinf(dn - d0);
    float dL = Ln - L;
    float da = sc * (a * rc - b * rs) - a + dL * NEUTRAL_A;
    float db = sc * (a * rs + b * rc) - b + dL * NEUTRAL_B;
    // output = input + change, with the change of the cube computed as a difference of cubes
    // (p1^3 - p0^3 = dp * (p1^2 + p1 p0 + p0^2)): no cancellation in bright pixels, exact 0 when nothing moves
    float3 dlab = make_float3(dL, da, db);
    float3 p0 = mat_oklab_m2_inv(lab);
    float3 dp = mat_oklab_m2_inv(dlab);                              // linear map: change in, change out
    float3 p1 = p0 + dp;
    float3 dlms = make_float3(dp.x * (p1.x * p1.x + p1.x * p0.x + p0.x * p0.x),
                              dp.y * (p1.y * p1.y + p1.y * p0.y + p0.y * p0.y),
                              dp.z * (p1.z * p1.z + p1.z * p0.z + p0.z * p0.z));
    float3 outl = lin + xyz_to_rgb(mat_oklab_m1_inv(dlms), ws);
    float3 rgb = encode_log(outl, ws);

    float alphaOut = outputAlpha ? zone * p_A : p_A;
    // Show Target: the whole frame is the target colour in the working space (to certify the delivered hex)
    if (showTarget) {                                                // UI checkbox, uniform: not a mask
        rgb = encode_log(xyz_to_rgb(txyz, ws), ws);
        alphaOut = p_A;
    }
    return make_float4(rgb.x, rgb.y, rgb.z, alphaOut);
}
